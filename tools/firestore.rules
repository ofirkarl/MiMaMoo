rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A shared space: whoever holds its link (an unguessable id) can read and edit what is inside.
    // Nobody can list the spaces themselves, so a link cannot be found by browsing.
    match /spaces/{space}/{collection}/{rest=**} {
      allow read, write: if request.auth != null;
    }
    // Personal lists: only the person who made them.
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
